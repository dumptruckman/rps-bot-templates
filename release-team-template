#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import subprocess
import sys
import tempfile
from typing import Any, Dict, Mapping, Optional, Tuple

from catalog_compatibility import (
    CompatibilityError,
    read_lock,
    verify_bundle,
    verify_checkout,
)
from template_collection import CollectionError, load_collection


PROJECT_ROOT = Path(__file__).resolve().parent
CORE_LOCK_PATH = PROJECT_ROOT / "core-tool.lock.json"
CORE_BUNDLE_PATH = PROJECT_ROOT / "core-tool.bundle"
TAG_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
FULL_ACTION_REF = re.compile(r"^[0-9a-f]{40}$")
FULL_DIGEST = re.compile(r"^sha256:[0-9a-f]{64}$")


class ReleaseError(RuntimeError):
    """The Team Template cannot be published or verified."""


def _run(*arguments: str, cwd: Path = PROJECT_ROOT) -> str:
    completed = subprocess.run(
        list(arguments), cwd=cwd, capture_output=True, text=True
    )
    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip()
        raise ReleaseError("command failed: " + " ".join(arguments) + ": " + detail)
    return completed.stdout.strip()


def _read_object(path: Path, label: str) -> Dict[str, Any]:
    try:
        value = json.loads(path.read_text())
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ReleaseError(label + " is unreadable: " + str(error)) from error
    if not isinstance(value, dict):
        raise ReleaseError(label + " must contain a JSON object")
    return value


def _relative_path(value: object, label: str) -> PurePosixPath:
    if not isinstance(value, str) or not value:
        raise ReleaseError(label + " must be a non-empty path")
    path = PurePosixPath(value)
    if (
        path.is_absolute()
        or not path.parts
        or any(part in ("", ".", "..") for part in path.parts)
        or "\\" in value
    ):
        raise ReleaseError(label + " must be a safe repository-relative POSIX path")
    return path


def _descriptor(
    tag: str,
    language_id: Optional[str] = None,
    catalog_path: Optional[Path] = None,
) -> Dict[str, str]:
    if catalog_path is None:
        raise ReleaseError("Team Template selection requires a verified catalog")
    try:
        selected = load_collection(PROJECT_ROOT, catalog_path).select(language_id)
    except CollectionError as error:
        raise ReleaseError("Team Template selection failed: " + str(error)) from error
    if selected.release_tag != tag:
        raise ReleaseError(
            "release tag " + repr(tag) + " does not match "
            + selected.descriptor_path.as_posix()
        )
    return {
        "format_version": "rps-team-template-v1",
        "version": selected.version,
        "path": selected.team_source_path.as_posix(),
        "expected_source_digest": selected.expected_source_digest,
        "release_tag": selected.release_tag,
        "advisory_validation_workflow": selected.advisory_validation_workflow.as_posix(),
        "language_id": selected.language_id,
        "language_environment": selected.language_environment,
        "participant_guidance_path": selected.participant_guidance_path.as_posix(),
        "build_and_test_entrypoint": selected.build_and_test_entrypoint.as_posix(),
    }


def _core_path() -> Path:
    configured = os.environ.get("RPS_CORE_PATH")
    if configured:
        return Path(configured).resolve()
    core_path = PROJECT_ROOT / ".core" / "rps-tournament"
    if not core_path.exists():
        _run(str(PROJECT_ROOT / "materialize-core-tool"), str(core_path))
    return core_path


def _catalog_compatibility() -> Mapping[str, Any]:
    try:
        lock = read_lock(CORE_LOCK_PATH)
        verify_bundle(CORE_BUNDLE_PATH, lock)
        verify_checkout(_core_path(), lock)
    except (CompatibilityError, OSError, KeyError, TypeError) as error:
        raise ReleaseError("catalog compatibility claim mismatch: " + str(error)) from error
    return lock


def _verify_immutable_action_references() -> None:
    workflow_directory = PROJECT_ROOT / ".github" / "workflows"
    paths = sorted(workflow_directory.glob("*.yml"))
    paths.extend(sorted(workflow_directory.glob("*.yaml")))
    for path in paths:
        try:
            workflow = path.read_text()
        except (OSError, UnicodeDecodeError) as error:
            raise ReleaseError("workflow is unreadable: " + str(error)) from error
        references = re.findall(
            r"^\s*-?\s*uses:\s*([^\s#]+)", workflow, re.MULTILINE
        )
        for reference in references:
            if reference.startswith("./"):
                continue
            if "@" not in reference:
                action_ref = ""
            else:
                action_ref = reference.rsplit("@", 1)[1]
            if not FULL_ACTION_REF.fullmatch(action_ref):
                relative = path.relative_to(PROJECT_ROOT)
                raise ReleaseError(
                    str(relative) + " uses mutable action ref " + repr(action_ref)
                )


def _file_digest(path: Path, label: str) -> str:
    if path.is_symlink() or not path.is_file():
        raise ReleaseError(label + " must be a repository-owned regular file")
    try:
        return "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()
    except OSError as error:
        raise ReleaseError(label + " is unreadable: " + str(error)) from error


def _validated_source_digest(
    descriptor: Mapping[str, str], compatibility: Mapping[str, Any]
) -> str:
    core = _core_path()
    catalog = core / str(compatibility["catalog"]["path"])
    source = PROJECT_ROOT.joinpath(
        *_relative_path(descriptor["path"], "Team Template path").parts
    )
    work = Path(tempfile.mkdtemp(prefix="rps-template-source-"))
    bundle = work / "source-bundle"
    environment = os.environ.copy()
    existing = environment.get("PYTHONPATH")
    environment["PYTHONPATH"] = str(core) + (
        os.pathsep + existing if existing else ""
    )
    try:
        completed = subprocess.run(
            [
                sys.executable,
                "-m",
                "rps_runner.source_cli",
                "--catalog",
                str(catalog),
                "--environment",
                descriptor["language_environment"],
                "--source",
                str(source),
                "--bundle",
                str(bundle),
            ],
            cwd=PROJECT_ROOT,
            env=environment,
            capture_output=True,
            text=True,
        )
        if completed.returncode != 0:
            detail = completed.stderr.strip() or completed.stdout.strip()
            raise ReleaseError("Team Template source validation failed: " + detail)
        source_manifest = _read_object(
            bundle / "source-bundle.json", "Team Template source bundle"
        )
        observed = source_manifest.get("source_digest")
        expected = descriptor["expected_source_digest"]
        if observed != expected:
            raise ReleaseError(
                "Team Template Source Digest mismatch: expected "
                + expected
                + ", got "
                + repr(observed)
            )
        if source_manifest.get("versions", {}).get("catalog") != compatibility[
            "catalog"
        ]["identity"]:
            raise ReleaseError("Team Template source validation used another catalog")
        return expected
    finally:
        for path in work.rglob("*"):
            try:
                path.chmod(0o700 if path.is_dir() else 0o600)
            except OSError:
                pass
        shutil.rmtree(work, ignore_errors=True)


def _team_template(
    descriptor: Mapping[str, str], compatibility: Mapping[str, Any]
) -> Dict[str, Any]:
    relative_root = _relative_path(descriptor["path"], "Team Template path")
    root = PROJECT_ROOT.joinpath(*relative_root.parts)
    if root.is_symlink() or not root.is_dir():
        raise ReleaseError("Team Template path must name a repository-owned directory")
    files: Dict[str, str] = {}
    for path in sorted(root.rglob("*")):
        if path.is_symlink():
            raise ReleaseError("Team Template must not contain symbolic links")
        if path.is_dir():
            continue
        if not path.is_file():
            raise ReleaseError("Team Template must contain only regular files")
        files[path.relative_to(root).as_posix()] = _file_digest(
            path, "Team Template file"
        )
    if not files:
        raise ReleaseError("Team Template must contain at least one file")
    canonical = json.dumps(files, sort_keys=True, separators=(",", ":")).encode(
        "utf-8"
    )
    digest = "sha256:" + hashlib.sha256(canonical).hexdigest()
    if not FULL_DIGEST.fullmatch(digest):
        raise ReleaseError("Team Template digest is invalid")
    return {
        "version": descriptor["version"],
        "path": relative_root.as_posix(),
        "expected_source_digest": _validated_source_digest(
            descriptor, compatibility
        ),
        "digest": digest,
        "files": files,
        "language_id": descriptor["language_id"],
        "language_environment": descriptor["language_environment"],
        "participant_guidance_path": descriptor["participant_guidance_path"],
        "build_and_test_entrypoint": descriptor["build_and_test_entrypoint"],
    }


def build_manifest(tag: str, language_id: Optional[str] = None) -> Dict[str, Any]:
    if not TAG_NAME.fullmatch(tag):
        raise ReleaseError(
            "release tag must use only letters, digits, dots, underscores, and hyphens"
        )
    compatibility = _catalog_compatibility()
    catalog_path = _core_path() / str(compatibility["catalog"]["path"])
    descriptor = _descriptor(tag, language_id, catalog_path)
    _verify_immutable_action_references()
    workflow_relative = _relative_path(
        descriptor["advisory_validation_workflow"],
        "Advisory Validation workflow path",
    )
    workflow_path = PROJECT_ROOT.joinpath(*workflow_relative.parts)
    workflow_digest = _file_digest(
        workflow_path, "Advisory Validation workflow"
    )
    return {
        "release_format_version": "template-release-v1",
        "template_repository": {
            "commit": _run("git", "rev-parse", "HEAD"),
            "tag": tag,
        },
        "team_template": _team_template(descriptor, compatibility),
        "catalog_compatibility": compatibility,
        "advisory_validation": {
            "workflow_path": workflow_relative.as_posix(),
            "workflow_identity": "team-advisory-validation-v1@" + workflow_digest,
            "supported_template_version": descriptor["version"],
        },
    }


def _require_clean_repository() -> None:
    if _run("git", "status", "--porcelain"):
        raise ReleaseError("repository must be clean before creating or verifying a release")


def _create_release(tag: str, language_id: Optional[str] = None) -> Dict[str, Any]:
    _require_clean_repository()
    try:
        _run("git", "rev-parse", "--verify", "refs/tags/" + tag)
    except ReleaseError:
        pass
    else:
        raise ReleaseError("release tag " + repr(tag) + " already exists")
    manifest = build_manifest(tag, language_id)
    annotation = json.dumps(manifest, indent=2, sort_keys=True)
    _run("git", "tag", "--no-sign", "--annotate", tag, "--message", annotation)
    return manifest


def _read_tag_manifest(tag: str) -> Tuple[str, Dict[str, Any]]:
    if not TAG_NAME.fullmatch(tag):
        raise ReleaseError("invalid release tag")
    object_type = _run("git", "cat-file", "-t", "refs/tags/" + tag)
    if object_type != "tag":
        raise ReleaseError("release tag " + repr(tag) + " must be an annotated tag")
    raw = _run("git", "cat-file", "tag", "refs/tags/" + tag)
    headers, separator, annotation = raw.partition("\n\n")
    if not separator:
        raise ReleaseError("release tag " + repr(tag) + " has no annotation")
    target = ""
    for line in headers.splitlines():
        if line.startswith("object "):
            target = line[len("object ") :]
            break
    try:
        manifest = json.loads(annotation)
    except json.JSONDecodeError as error:
        raise ReleaseError(
            "release tag " + repr(tag) + " does not contain a JSON manifest"
        ) from error
    if not isinstance(manifest, dict):
        raise ReleaseError("release tag manifest must be a JSON object")
    return target, manifest


def _verify_release(tag: str, language_id: Optional[str] = None) -> Dict[str, Any]:
    _require_clean_repository()
    target, recorded = _read_tag_manifest(tag)
    head = _run("git", "rev-parse", "HEAD")
    if target != head:
        raise ReleaseError(
            "release tag " + repr(tag) + " targets the wrong Template repository commit"
        )
    recorded_template = recorded.get("team_template")
    if not isinstance(recorded_template, dict):
        raise ReleaseError("release manifest omits the Team Template identity")
    recorded_language = recorded_template.get("language_id")
    if not isinstance(recorded_language, str) or not recorded_language:
        raise ReleaseError("release manifest omits a valid language ID")
    try:
        if language_id is not None:
            if recorded_language != language_id:
                raise ReleaseError(
                    "release language "
                    + repr(recorded_language)
                    + " does not match selected Team Template "
                    + repr(language_id)
                )
            expected = build_manifest(tag, language_id)
        else:
            expected = build_manifest(tag, recorded_language)
    except ReleaseError as error:
        if "Team Template Source Digest mismatch" in str(error):
            raise ReleaseError(
                "Team Template changed since the release was created: " + str(error)
            ) from error
        raise
    if recorded.get("team_template") != expected["team_template"]:
        raise ReleaseError("Team Template changed since the release was created")
    if recorded != expected:
        raise ReleaseError("release manifest does not match the Template repository contents")
    return recorded


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Create or verify an immutable Template Release"
    )
    parser.add_argument(
        "--template",
        metavar="LANGUAGE_ID",
        help="select a Team Template from team-templates.json",
    )
    parser.add_argument("command", choices=("manifest", "create", "verify"))
    parser.add_argument("tag")
    arguments = parser.parse_args()
    try:
        if arguments.command == "manifest":
            manifest = build_manifest(arguments.tag, arguments.template)
        elif arguments.command == "create":
            manifest = _create_release(arguments.tag, arguments.template)
        else:
            manifest = _verify_release(arguments.tag, arguments.template)
    except ReleaseError as error:
        print("Template Release failure: " + str(error), file=sys.stderr)
        return 1
    print(json.dumps(manifest, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
