#!/usr/bin/env python3
from __future__ import annotations

import argparse
import configparser
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from typing import Any


PROJECT_ROOT = Path(__file__).resolve().parent
CATALOG_PATH = PROJECT_ROOT / "language_environments" / "catalog-v1" / "catalog.json"
CORE_LOCK_PATH = PROJECT_ROOT / "core-tool.lock.json"
FULL_COMMIT = re.compile(r"^[0-9a-f]{40}$")
FULL_DIGEST = re.compile(r"^sha256:[0-9a-f]{64}$")
FULL_ACTION_REF = re.compile(r"^[0-9a-f]{40}$")
TAG_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


class ReleaseError(RuntimeError):
    pass


def _run(*arguments: str, cwd: Path = PROJECT_ROOT) -> str:
    completed = subprocess.run(
        list(arguments), cwd=cwd, capture_output=True, text=True
    )
    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip()
        raise ReleaseError("command failed: " + " ".join(arguments) + ": " + detail)
    return completed.stdout.strip()


def _read_object(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text())
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ReleaseError(f"could not read {path.relative_to(PROJECT_ROOT)}: {error}")
    if not isinstance(value, dict):
        raise ReleaseError(f"{path.relative_to(PROJECT_ROOT)} must contain a JSON object")
    return value


def _core_path() -> Path:
    configured = os.environ.get("RPS_CORE_PATH")
    if configured:
        return Path(configured).resolve()
    core_path = PROJECT_ROOT / ".core" / "rps-tournament"
    if not core_path.exists():
        _run(str(PROJECT_ROOT / "materialize-core-tool"), str(core_path))
    return core_path


def _verify_core_bundle(lock: dict[str, Any]) -> None:
    try:
        bundle_record = lock["bundle"]
        relative_path = Path(bundle_record["path"])
        expected_digest = bundle_record["sha256"]
    except (KeyError, TypeError) as error:
        raise ReleaseError("core-tool.lock.json must pin the bundled core history") from error
    unresolved_bundle_path = PROJECT_ROOT / relative_path
    bundle_path = unresolved_bundle_path.resolve()
    if (
        relative_path.is_absolute()
        or PROJECT_ROOT not in bundle_path.parents
        or unresolved_bundle_path.is_symlink()
        or not bundle_path.is_file()
    ):
        raise ReleaseError("core tool bundle must be a repository-owned regular file")
    if not FULL_DIGEST.fullmatch(str(expected_digest)):
        raise ReleaseError("core tool bundle must be pinned by a full SHA-256 digest")
    actual_digest = "sha256:" + hashlib.sha256(bundle_path.read_bytes()).hexdigest()
    if actual_digest != expected_digest:
        raise ReleaseError(
            f"core tool bundle digest is {actual_digest}; expected {expected_digest}"
        )


def _verify_core_pin(core_path: Path, lock: dict[str, Any]) -> None:
    if not FULL_COMMIT.fullmatch(str(lock.get("commit", ""))):
        raise ReleaseError("core-tool.lock.json must pin a full 40-character commit")
    if not re.fullmatch(r"[^/\s]+/[^/\s]+", str(lock.get("repository", ""))):
        raise ReleaseError("core-tool.lock.json must name an owner/repository")
    if not str(lock.get("package_version", "")):
        raise ReleaseError("core-tool.lock.json must pin a package version")

    actual_commit = _run("git", "rev-parse", "HEAD", cwd=core_path)
    if actual_commit != lock["commit"]:
        raise ReleaseError(
            f"pinned core checkout is {actual_commit}; expected {lock['commit']}"
        )
    if _run("git", "status", "--porcelain", "--untracked-files=no", cwd=core_path):
        raise ReleaseError("pinned core checkout has tracked modifications")

    package = configparser.ConfigParser()
    package.read(core_path / "setup.cfg")
    actual_version = package.get("metadata", "version", fallback="")
    if actual_version != lock["package_version"]:
        raise ReleaseError(
            f"pinned core package version is {actual_version!r}; "
            f"expected {lock['package_version']!r}"
        )


def _verify_immutable_references(catalog: dict[str, Any]) -> None:
    python = catalog.get("environments", {}).get("python", {})
    runtimes_path = CATALOG_PATH.parent / python.get("assets", {}).get(
        "base_runtime", {}
    ).get("path", "")
    runtimes = _read_object(runtimes_path)
    platforms = runtimes.get("platforms", {})
    if set(platforms) != {"linux/amd64", "linux/arm64"}:
        raise ReleaseError("Python runtimes must pin linux/amd64 and linux/arm64")
    for platform, runtime in platforms.items():
        reference = str(runtime.get("image", ""))
        if "@" not in reference or not FULL_DIGEST.fullmatch(reference.rsplit("@", 1)[1]):
            raise ReleaseError(f"{platform} runtime is not pinned by full digest")
        if ":latest" in reference.lower():
            raise ReleaseError(f"{platform} runtime uses mutable latest")

    workflow_paths = sorted((PROJECT_ROOT / ".github" / "workflows").glob("*.yml"))
    workflow_paths.extend(sorted((PROJECT_ROOT / ".github" / "workflows").glob("*.yaml")))
    workflow_paths.append(CATALOG_PATH.parent / "python" / "workflow.yml")
    for workflow_path in workflow_paths:
        text = workflow_path.read_text()
        for reference in re.findall(r"^\s*-?\s*uses:\s*[^@\s]+@([^\s#]+)", text, re.MULTILINE):
            if not FULL_ACTION_REF.fullmatch(reference):
                raise ReleaseError(
                    f"{workflow_path.relative_to(PROJECT_ROOT)} uses mutable action ref {reference!r}"
                )

    dependency_path = CATALOG_PATH.parent / python["assets"]["dependency_definition"]["path"]
    dependency_entries = [
        line.strip()
        for line in dependency_path.read_text().splitlines()
        if line.strip() and not line.lstrip().startswith("#")
    ]
    if dependency_entries:
        raise ReleaseError("the first Python catalog must remain standard-library-only")

    dockerfile_path = CATALOG_PATH.parent / python["assets"]["recipe"]["path"]
    dockerfile = dockerfile_path.read_text()
    if re.search(r"^\s*RUN\s", dockerfile, re.MULTILINE | re.IGNORECASE):
        raise ReleaseError("the Python recipe must not perform build-time downloads or installs")


def build_manifest(tag: str) -> dict[str, Any]:
    if not TAG_NAME.fullmatch(tag):
        raise ReleaseError("release tag must use only letters, digits, dots, underscores, and hyphens")

    core_path = _core_path()
    lock = _read_object(CORE_LOCK_PATH)
    _verify_core_bundle(lock)
    _verify_core_pin(core_path, lock)
    catalog_data = _read_object(CATALOG_PATH)
    _verify_immutable_references(catalog_data)

    sys.path.insert(0, str(core_path))
    try:
        from rps_runner.artifact_certification import SUITE_VERSION, _core_tool_identity
        from rps_runner.execution_profile import INITIAL_EXECUTION_PROFILE
        from rps_runner.language_environment import load_catalog
    except ImportError as error:
        raise ReleaseError(f"could not load the pinned core tool: {error}") from error

    try:
        catalog = load_catalog(CATALOG_PATH)
    except Exception as error:
        raise ReleaseError(f"catalog content verification failed: {error}") from error
    environment = catalog.environment("python")
    runtime_catalog = json.loads(environment.assets["base_runtime"].content)

    def asset_record(name: str) -> dict[str, str]:
        asset = environment.assets[name]
        return {"version": asset.version, "identity": asset.identity}

    runtimes: dict[str, dict[str, str]] = {}
    for platform, runtime in sorted(runtime_catalog["platforms"].items()):
        reference = runtime["image"]
        runtimes[platform] = {
            "version": runtime["version"],
            "reference": reference,
            "digest": reference.rsplit("@", 1)[1],
        }

    assets = {
        name: {"version": asset.version, "digest": asset.digest}
        for name, asset in sorted(environment.assets.items())
    }
    return {
        "release_format_version": "catalog-release-v1",
        "repository": {
            "commit": _run("git", "rev-parse", "HEAD"),
            "tag": tag,
        },
        "catalog": {"version": catalog.version, "identity": catalog.identity},
        "core_tool": {"pin": lock, "identity": _core_tool_identity()},
        "conformance_suite": {
            "version": SUITE_VERSION,
            "identity": SUITE_VERSION + "@" + environment.assets["conformance"].digest,
        },
        "execution_profile": {
            "version": INITIAL_EXECUTION_PROFILE.version,
            "identity": INITIAL_EXECUTION_PROFILE.identity,
        },
        "language_environments": {
            "python": {
                "descriptor_version": environment.descriptor_version,
                "wrapper": asset_record("wrapper"),
                "recipe": asset_record("recipe"),
                "runtimes": runtimes,
                "dependencies": {
                    "version": environment.assets["dependency_definition"].version,
                    "standard_library_only": True,
                    "build_time_downloads": False,
                },
                "assets": assets,
            }
        },
    }


def _require_clean_repository() -> None:
    if _run("git", "status", "--porcelain"):
        raise ReleaseError("repository must be clean before freezing or verifying a release")


def _create_release(tag: str) -> dict[str, Any]:
    _require_clean_repository()
    try:
        _run("git", "rev-parse", "--verify", f"refs/tags/{tag}")
    except ReleaseError:
        pass
    else:
        raise ReleaseError(f"release tag {tag!r} already exists")
    manifest = build_manifest(tag)
    annotation = json.dumps(manifest, indent=2, sort_keys=True)
    _run("git", "tag", "--no-sign", "--annotate", tag, "--message", annotation)
    return manifest


def _read_tag_manifest(tag: str) -> tuple[str, dict[str, Any]]:
    if not TAG_NAME.fullmatch(tag):
        raise ReleaseError("invalid release tag")
    raw = _run("git", "cat-file", "tag", f"refs/tags/{tag}")
    headers, separator, annotation = raw.partition("\n\n")
    if not separator:
        raise ReleaseError(f"release tag {tag!r} has no annotation")
    target = ""
    for line in headers.splitlines():
        if line.startswith("object "):
            target = line.removeprefix("object ")
            break
    try:
        manifest = json.loads(annotation)
    except json.JSONDecodeError as error:
        raise ReleaseError(f"release tag {tag!r} does not contain a JSON manifest") from error
    if not isinstance(manifest, dict):
        raise ReleaseError(f"release tag {tag!r} manifest must be a JSON object")
    return target, manifest


def _verify_release(tag: str) -> dict[str, Any]:
    _require_clean_repository()
    target, recorded = _read_tag_manifest(tag)
    head = _run("git", "rev-parse", "HEAD")
    if target != head:
        raise ReleaseError(
            f"release tag {tag!r} targets {target}; check out that commit before verification"
        )
    expected = build_manifest(tag)
    if recorded != expected:
        raise ReleaseError("release manifest does not match the frozen repository contents")
    return recorded


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Create or verify an immutable Language Environment Catalog release"
    )
    parser.add_argument("command", choices=("manifest", "create", "verify"))
    parser.add_argument("tag")
    arguments = parser.parse_args()
    try:
        if arguments.command == "manifest":
            manifest = build_manifest(arguments.tag)
        elif arguments.command == "create":
            manifest = _create_release(arguments.tag)
        else:
            manifest = _verify_release(arguments.tag)
    except ReleaseError as error:
        print(f"Language Environment Catalog release failure: {error}", file=sys.stderr)
        return 1
    print(json.dumps(manifest, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
