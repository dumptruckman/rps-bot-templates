#!/usr/bin/env python3
"""Prepare a verified Catalog Release lock update without editing the repository."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
from typing import Any, Mapping, Sequence

from catalog_compatibility import (
    CompatibilityError,
    read_independence_evidence,
    read_lock,
    verify_bundle,
    verify_checkout,
)


class UpdateError(ValueError):
    """Published Runner inputs cannot safely become a compatibility lock."""


def _run(arguments: Sequence[str]) -> None:
    completed = subprocess.run(list(arguments), capture_output=True, text=True)
    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip()
        raise UpdateError("command failed: " + " ".join(arguments) + ": " + detail)


def _write_json(path: Path, value: Mapping[str, Any]) -> None:
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")


def _prepare(
    *, bundle: Path, evidence_path: Path, output: Path
) -> Mapping[str, Any]:
    if output.exists() or output.is_symlink():
        raise UpdateError("output already exists and will not be replaced")
    try:
        evidence = read_independence_evidence(evidence_path)
    except CompatibilityError as error:
        raise UpdateError(str(error)) from error
    coordinates = evidence["compatibility_coordinates"]

    output.parent.mkdir(parents=True, exist_ok=True)
    staging_path: Path | None = None
    try:
        staging_path = Path(
            tempfile.mkdtemp(prefix=".catalog-lock-update-", dir=str(output.parent))
        )
        lock_path = staging_path / "core-tool.lock.json"
        bundle_path = staging_path / "core-tool.bundle"
        retained_evidence = staging_path / "runner-catalog-independence.json"
        _write_json(lock_path, coordinates)
        shutil.copyfile(bundle, bundle_path)
        _write_json(retained_evidence, evidence)

        lock = read_lock(lock_path)
        verify_bundle(bundle_path, lock)
        checkout = staging_path / "verified-runner"
        _run(("git", "clone", "--quiet", str(bundle_path), str(checkout)))
        _run(
            (
                "git",
                "-C",
                str(checkout),
                "checkout",
                "--quiet",
                "--detach",
                str(lock["runner"]["commit"]),
            )
        )
        verify_checkout(checkout, lock)
        shutil.rmtree(checkout)
        staging_path.rename(output)
        staging_path = None
    except (CompatibilityError, KeyError, OSError, TypeError) as error:
        raise UpdateError(str(error)) from error
    finally:
        if staging_path is not None:
            shutil.rmtree(staging_path, ignore_errors=True)
    return coordinates


def main(arguments: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Prepare one verified Runner bundle, compatibility lock, and "
            "catalog-independence evidence set"
        )
    )
    parser.add_argument("--runner-bundle", required=True, type=Path)
    parser.add_argument("--runner-evidence", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    options = parser.parse_args(arguments)
    try:
        coordinates = _prepare(
            bundle=options.runner_bundle.expanduser().resolve(),
            evidence_path=options.runner_evidence.expanduser().resolve(),
            output=options.output.expanduser().resolve(),
        )
    except UpdateError as error:
        print("Catalog lock preparation failure: " + str(error), file=sys.stderr)
        return 1
    print(json.dumps(coordinates, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
