#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import json
from pathlib import Path
import subprocess
import sys
from typing import Sequence


ROOT = Path(__file__).resolve().parent
LOCK_PATH = ROOT / "core-tool.lock.json"


def run(arguments: Sequence[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(list(arguments), capture_output=True, text=True)


def fail(detail: str) -> int:
    print("Pinned core tool materialization failure: " + detail, file=sys.stderr)
    return 1


def main() -> int:
    destination = (
        Path(sys.argv[1]).resolve()
        if len(sys.argv) == 2
        else ROOT / ".core" / "rps-tournament"
    )
    if len(sys.argv) > 2:
        return fail("usage: materialize-core-tool [destination]")
    try:
        lock = json.loads(LOCK_PATH.read_text())
        bundle_record = lock["offline_bundle"]
        bundle = ROOT / bundle_record["path"]
        expected_identity = bundle_record["identity"]
        expected_commit = lock["runner"]["commit"]
        actual_identity = (
            "rps-runner-offline-bundle-v1@sha256:"
            + hashlib.sha256(bundle.read_bytes()).hexdigest()
        )
    except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError) as error:
        return fail(str(error))
    if actual_identity != expected_identity:
        return fail(
            f"{bundle.name} identity is {actual_identity}; expected {expected_identity}"
        )

    if destination.exists():
        head = run(["git", "-C", str(destination), "rev-parse", "HEAD"])
        status = run(["git", "-C", str(destination), "status", "--porcelain"])
        if (
            head.returncode == 0
            and head.stdout.strip() == expected_commit
            and status.returncode == 0
            and not status.stdout.strip()
        ):
            print(destination)
            return 0
        return fail(f"existing destination is not a clean checkout of {expected_commit}")

    destination.parent.mkdir(parents=True, exist_ok=True)
    cloned = run(["git", "clone", "--quiet", str(bundle), str(destination)])
    if cloned.returncode != 0:
        return fail(cloned.stderr.strip() or "could not clone bundled core history")
    checked_out = run(
        ["git", "-C", str(destination), "checkout", "--quiet", "--detach", expected_commit]
    )
    if checked_out.returncode != 0:
        return fail(checked_out.stderr.strip() or "bundled core commit is unavailable")
    print(destination)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
