#!/usr/bin/env python3
from __future__ import annotations

from pathlib import Path
import subprocess
import sys
from typing import Sequence

from catalog_compatibility import (
    CompatibilityError,
    read_lock,
    verify_bundle,
    verify_checkout,
)


ROOT = Path(__file__).resolve().parent
LOCK_PATH = ROOT / "core-tool.lock.json"
BUNDLE_PATH = ROOT / "core-tool.bundle"


def run(arguments: Sequence[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(list(arguments), capture_output=True, text=True)


def fail(detail: str) -> int:
    print(
        "Pinned Catalog Release materialization failure: "
        + detail
        + ". Organizer action: restore the locked bundle and compatibility claim, "
        "then rematerialize the Runner checkout.",
        file=sys.stderr,
    )
    return 1


def main() -> int:
    destination = (
        Path(sys.argv[1]).resolve()
        if len(sys.argv) == 2
        else ROOT / ".core" / "rps-tournament"
    )
    if len(sys.argv) > 2:
        return fail("usage: materialize-core-tool [destination]")
    try:
        lock = read_lock(LOCK_PATH)
        expected_commit = lock["runner"]["commit"]
        verify_bundle(BUNDLE_PATH, lock)
    except (OSError, KeyError, TypeError, CompatibilityError) as error:
        return fail(str(error))

    if destination.exists():
        try:
            verify_checkout(destination, lock)
            print(destination)
            return 0
        except CompatibilityError as error:
            return fail("existing destination is not a clean checkout: " + str(error))

    destination.parent.mkdir(parents=True, exist_ok=True)
    cloned = run(["git", "clone", "--quiet", str(BUNDLE_PATH), str(destination)])
    if cloned.returncode != 0:
        return fail(cloned.stderr.strip() or "could not clone bundled core history")
    checked_out = run(
        ["git", "-C", str(destination), "checkout", "--quiet", "--detach", expected_commit]
    )
    if checked_out.returncode != 0:
        return fail(checked_out.stderr.strip() or "bundled core commit is unavailable")
    try:
        verify_checkout(destination, lock)
    except CompatibilityError as error:
        return fail(str(error))
    print(destination)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
