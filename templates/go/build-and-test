#!/bin/sh
set -eu

if ! command -v go >/dev/null 2>&1; then
  printf '%s\n' \
    'Native toolchain failure: Go is required; rerun check-team-template with --mode docker.' >&2
  exit 2
fi

go_version=$(go env GOVERSION)
case "$go_version" in
  go1.2[6-9]*|go1.[3-9][0-9]*) ;;
  *)
    printf '%s\n' \
      'Native toolchain failure: Go 1.26 or newer is required; rerun check-team-template with --mode docker.' >&2
    exit 2
    ;;
esac

template_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
temporary=$(mktemp -d "${TMPDIR:-/tmp}/rps-go-template.XXXXXX")
trap 'rm -rf "$temporary"' EXIT HUP INT TERM

cp -R "$template_root/team_source/." "$temporary/"
cp "$template_root/tests/strategy_test.go" "$temporary/strategy_test.go"

(
  cd "$temporary"
  GO111MODULE=off GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off GOCACHE="$temporary/cache" \
    go test -c -o "$temporary/strategy.test"
)
printf '%s\n' 'Go starter build passed'

"$temporary/strategy.test" -test.v
printf '%s\n' 'Go starter tests passed'
