#!/bin/sh
set -eu

if ! command -v javac >/dev/null 2>&1 || ! command -v java >/dev/null 2>&1; then
  printf '%s\n' \
    'Native toolchain failure: Java 25 JDK is required; rerun check-team-template with --mode docker.' >&2
  exit 2
fi

java_version=$(javac -version 2>&1 | awk '{print $2}')
java_major=${java_version%%.*}
case "$java_major" in
  2[5-9]|[3-9][0-9]) ;;
  *)
    printf '%s\n' \
      'Native toolchain failure: Java 25 or newer is required; rerun check-team-template with --mode docker.' >&2
    exit 2
    ;;
esac

template_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
temporary=$(mktemp -d "${TMPDIR:-/tmp}/rps-java-template.XXXXXX")
trap 'rm -rf "$temporary"' EXIT HUP INT TERM

mkdir -p "$temporary/source" "$temporary/classes"
cp -R "$template_root/team_source/." "$temporary/source/"
cp "$template_root/tests/StrategyTest.java" "$temporary/StrategyTest.java"

javac --release 25 -encoding UTF-8 -d "$temporary/classes" \
  "$temporary/source/"*.java "$temporary/StrategyTest.java"
printf '%s\n' 'Java starter build passed'

java -ea -cp "$temporary/classes" StrategyTest
printf '%s\n' 'Java starter tests passed'
